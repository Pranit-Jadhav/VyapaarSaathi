# Required
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional runtime settings
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
FFMPEG_BINARY=ffmpeg
TWILIO_VALIDATE_SIGNATURE=true

# Optional weekly summary
ENABLE_WEEKLY_SUMMARY=false
ENABLE_WEEKLY_SUMMARY_TTS=false

# Optional proactive stock alerts (WhatsApp)
ENABLE_INSTANT_STOCK_ALERTS=true
INSTANT_STOCK_ALERT_INTERVAL_SECONDS=60
INSTANT_STOCK_ALERT_UNITS_THRESHOLD=20
# Comma-separated WhatsApp numbers. Example: whatsapp:+91XXXXXXXXXX
INSTANT_STOCK_ALERT_RECIPIENTS=
